# §VRDUAL-7A：把 git HEAD 前 12 hex 與 dirty 寫進 viple_build_id_gen.h。
# 內容沒變就不覆寫，避免每次建置都讓翻譯單元重新編譯。
# git 失敗時寫 present、hash 0（文字 unknown）。server 與 driver 都這樣就視為相同，不印警告。
# 編碼：bit 63＝有填、bit 62＝dirty、bits 0–47＝前 12 hex。不改 IPC 結構。

if(NOT DEFINED OUT OR NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "write_viple_build_id.cmake 需要 -DOUT 與 -DSOURCE_DIR")
endif()

set(VIPLE_BID_PACKED "0x8000000000000000")
set(VIPLE_BID_TEXT "unknown")

execute_process(
        COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE _viple_head
        ERROR_VARIABLE _viple_git_err
        RESULT_VARIABLE _viple_git_rc
        OUTPUT_STRIP_TRAILING_WHITESPACE
)
if(_viple_git_rc EQUAL 0 AND _viple_head MATCHES "^[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]")
    string(SUBSTRING "${_viple_head}" 0 12 _viple_hex12)
    string(TOLOWER "${_viple_hex12}" _viple_hex12)
    execute_process(
            COMMAND git -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE _viple_por
            RESULT_VARIABLE _viple_st_rc
            OUTPUT_STRIP_TRAILING_WHITESPACE
    )
    set(_viple_dirty 0)
    if(_viple_st_rc EQUAL 0 AND NOT "${_viple_por}" STREQUAL "")
        set(_viple_dirty 1)
    endif()
    # 高 16 bit：bit63 必為 1（0x8000）；dirty 再加 bit62（0xC000）。低 48 bit＝hex12。
    if(_viple_dirty)
        set(VIPLE_BID_PACKED "0xC000${_viple_hex12}")
        set(VIPLE_BID_TEXT "${_viple_hex12}-dirty")
    else()
        set(VIPLE_BID_PACKED "0x8000${_viple_hex12}")
        set(VIPLE_BID_TEXT "${_viple_hex12}")
    endif()
endif()

set(_viple_template [=[// Generated by cmake/prep/write_viple_build_id.cmake. Do not edit.
// §VRDUAL-7A
#pragma once
#define VIPLE_BUILD_ID_PACKED @VIPLE_BID_PACKED@ull
#define VIPLE_BUILD_ID_TEXT "@VIPLE_BID_TEXT@"
]=])
string(CONFIGURE "${_viple_template}" _viple_content @ONLY)

if(EXISTS "${OUT}")
    file(READ "${OUT}" _viple_old)
    string(REPLACE "\r\n" "\n" _viple_old "${_viple_old}")
    string(REPLACE "\r" "\n" _viple_old "${_viple_old}")
    if(_viple_old STREQUAL _viple_content)
        return()
    endif()
endif()
get_filename_component(_viple_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_viple_dir}")
file(WRITE "${OUT}" "${_viple_content}")

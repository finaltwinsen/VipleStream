// driver.rc - VipleStream SteamVR driver version resource (ASCII only: rc.exe).
#include <winver.h>
#include "driver_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VIPLE_DRIVER_VERSION_RC
 PRODUCTVERSION VIPLE_DRIVER_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VipleStream"
            VALUE "FileDescription", "VipleStream SteamVR driver"
            VALUE "FileVersion", VIPLE_DRIVER_VERSION_STR ".0"
            VALUE "InternalName", "driver_viplestream"
            VALUE "OriginalFilename", "driver_viplestream.dll"
            VALUE "ProductName", "VipleStream"
            VALUE "ProductVersion", VIPLE_DRIVER_VERSION_STR ".0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

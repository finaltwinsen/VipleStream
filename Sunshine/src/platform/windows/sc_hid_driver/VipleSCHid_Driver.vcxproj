<?xml version="1.0" encoding="utf-8"?>
<!--
  §SC-HID: VipleSCHid_Driver.vcxproj
  UMDF2 HID minidriver for virtual Steam Controller (VID=0x28DE, PID=0x1102).

  Prerequisites:
    1. Visual Studio 2022 (any edition)
    2. Windows Driver Kit (WDK) for Windows 11 — download from:
         https://learn.microsoft.com/en-us/windows-hardware/drivers/download-the-wdk
       Install WDK *after* VS2022 so the VS extension (WDK.vsix) is auto-registered.
    3. Windows SDK 10.0.26100+ (already present via VS installer)

  Build via Build-ScHidDriver.ps1 or:
    msbuild VipleSCHid_Driver.vcxproj /p:Configuration=Release /p:Platform=x64
-->
<Project DefaultTargets="Build" ToolsVersion="15.0"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B3F7E2A1-9C4D-4F68-B0A5-D6E9C1234567}</ProjectGuid>
    <ProjectName>VipleSCHid_Driver</ProjectName>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <DriverType>UMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <!-- WindowsUserModeDriver10.0 is provided by WDK VS integration (WDK.vsix) -->
    <PlatformToolset>WindowsUserModeDriver10.0</PlatformToolset>
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- WDK common props (sets KernelModeIncludes, UmdfIncludes, etc.) -->
  <Import Project="$(WDKContentRoot)build\WindowsDriver.Common.props"
      Condition="Exists('$(WDKContentRoot)build\WindowsDriver.Common.props')" />

  <PropertyGroup>
    <OutDir>$(ProjectDir)out\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>VipleSCHid_Driver</TargetName>
    <TargetExt>.dll</TargetExt>
    <!-- Suppress Inf2Cat in MSBuild — we run it manually in Build-ScHidDriver.ps1 -->
    <RunInf2Cat>false</RunInf2Cat>
    <SignMode>Off</SignMode>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>
        UMDF_USING_NTSTATUS;WIN32;_WIN64;NDEBUG;_USRDLL;%(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <AdditionalIncludeDirectories>
        <!-- WDK UMDF2 and HID DDI headers -->
        $(WDKContentRoot)Include\$(WindowsTargetPlatformVersion)\wdf\umdf\2.0;
        $(WDKContentRoot)Include\$(WindowsTargetPlatformVersion)\km;
        $(WDKContentRoot)Include\$(WindowsTargetPlatformVersion)\shared;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <AdditionalDependencies>
        <!-- UMDF2 framework library -->
        $(WDKContentRoot)Lib\$(WindowsTargetPlatformVersion)\wdf\umdf\x64\2.0\WdfCore.lib;
        OneCoreUAP.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
      <AdditionalLibraryDirectories>
        $(WDKContentRoot)Lib\$(WindowsTargetPlatformVersion)\wdf\umdf\x64\2.0;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <!-- UMDF2 DLL entry point for driver DLLs is WdfDriverEntry or DllMain;
           with WdfCore.lib the framework provides a WdfDriverEntry wrapper -->
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="VipleSCHid_Driver.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- WDK common targets -->
  <Import Project="$(WDKContentRoot)build\WindowsDriver.Common.targets"
      Condition="Exists('$(WDKContentRoot)build\WindowsDriver.Common.targets')" />

</Project>
